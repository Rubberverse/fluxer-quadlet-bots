[Unit]
Description=Fluxy - a buggy in-dev moderation and qol bot for fluxer https://fluxy.gay
Requires=fluxy-mongodb.service
After=fluxy-mongodb.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false

[Container]
Image=Fluxy.build
ContainerName=fluxy
EnvironmentFile=%h/Environments/Fluxer/Fluxy.env
Volume=fluxy-gateway-session:/data:U,Z
Tmpfs=/tmp:rw,size=16M,noexec,nosuid,nodev
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
Memory=512M
PodmanArgs=--cpus=1
PodmanArgs=--memory-swap=0M
UserNS=auto:size=1002
Network=fluxy.network
Network=fluxy-mongodb.network
