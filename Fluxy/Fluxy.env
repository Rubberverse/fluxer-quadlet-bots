NODE_ENV=production
WAIT_FOR_MONGO=false
TOKEN=Applications -> Your Bot -> Bot Token
MONGO_URI=mongodb://username:password@fluxy-mongo:27017/fluxer-mod-bot
PREFIX=?
GATEWAY_SESSION_PATH=/data/.gateway-session.json
OWNER_ID=YourUserID
TERMINATION_APPEAL_TAG=username#6767
BRANDING_PUBLIC_NAME=Test
BRANDING_FULL_NAME=Example Text
BRANDING_DATA_NAME=test
BRANDING_RSS_USER_AGENT_NAME=TestRSS
BRANDING_SOCIALS_USER_AGENT_NAME=TestMyService
LOG_LEVEL=info
DEBUG=false
FLUXY_PROCESS=all
BOT_INTERNAL_PORT=4001
BOT_INTERNAL_URL=http://127.0.0.1:4001
BOT_INTERNAL_BIND=127.0.0.1
FLUXER_INSTANCE_API=https://chat.example.com/api
FLUXER_INSTANCE_GATEWAY=wss://chat.example.com/gateway
FLUXER_INSTANCE_WEB=https://chat.example.com
FLUXER_INSTANCE_MEDIA=https://chat.example.com/media
API_ENABLED=true
API_PORT=4000
API_ADMIN_TOKEN=openssl rand -hex 32
APPEAL_SIGNING_SECRET=openssl rand -hex 32
FLUXER_OAUTH_CLIENT_ID=Same as VITE_FLUXER_CLIENT_ID
FLUXER_OAUTH_CLIENT_SECRET=Applications -> Your Bot -> Client Secret Token / Key
FLUXER_OAUTH_REDIRECT_URI=https://fluxy.example.com/auth/callback
RSS_ENABLED=false
DASHBOARD_URL=https://fluxy.example.com
FLUXY_STATUS_URL=https://fluxy.example.com/api/public/status
